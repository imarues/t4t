# انسخ هذا الملف باسم .env محلياً، أو أضف نفس المتغيرات
# في تبويب "Secrets" داخل Replit (لا ترفع القيم الحقيقية إلى GitHub أبداً)

# توكن البوت من BotFather
BOT_TOKEN=

# بيانات تطبيق Telegram API (من https://my.telegram.org)
TG_API_ID=
TG_API_HASH=

# اختياري: حدود الملفات (بايت)
MAX_FILE_BYTES=2000000000
MAX_SOURCE_BYTES=4000000000
MAX_EXTRACTED_BYTES=12000000000

# اختياري: معرف قناة تقارير الروابط
LINK_REPORT_CHANNEL_ID=-1003734893457
